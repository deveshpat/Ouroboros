# Copy to .env.local, fill values, then load with:
#   set -a; source .env.local; set +a

# Required only for publishing to Hugging Face Hub.
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# Optional defaults used by examples.
OUROBOROS_BASE_MODEL=ai21labs/AI21-Jamba-Reasoning-3B
OUROBOROS_HUB_MODEL_ID=WeirdRunner/Ouroboros
OUROBOROS_TRAIN=data/coconut_v1/train.jsonl
OUROBOROS_VALIDATION=data/coconut_v1/val.jsonl
OUROBOROS_OUTPUT_DIR=runs/ouroboros
OUROBOROS_STAGES=0-10
