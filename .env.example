# Ouroboros local secrets template.
# Copy to .env.local, fill values, then load with:
#   set -a; source .env.local; set +a

# Hugging Face Hub.
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# Weights & Biases.
WANDB_KEY=
WANDB_API_KEY=
OUROBOROS_WANDB_PROJECT=ouroboros-stage3-jamba
OUROBOROS_WANDB_ENTITY=

# Kaggle notebook mode.
# Options: infer, infer_edge, train_canary, eval_lm, eval_gate.
OUROBOROS_KAGGLE_RUN_MODE=infer

# Inference smoke controls.
OUROBOROS_INFERENCE_PROMPT=Explain the core idea briefly.
OUROBOROS_INFERENCE_BASE_MODEL=ai21labs/AI21-Jamba-Reasoning-3B
OUROBOROS_INFERENCE_ADAPTER_REPO=WeirdRunner/Ouroboros
OUROBOROS_INFERENCE_ADAPTER_SUBFOLDER=diloco_state/anchor
OUROBOROS_INFERENCE_ADAPTER_DIR=
OUROBOROS_INFERENCE_STAGE_K=10
OUROBOROS_INFERENCE_MAX_NEW_TOKENS=128
OUROBOROS_INFERENCE_MAX_SEQ_LEN=512
OUROBOROS_INFERENCE_USE_HALT_GATE=1
OUROBOROS_INFERENCE_USE_4BIT=0
OUROBOROS_INFERENCE_MODEL_DEVICE_MAP=single
OUROBOROS_INFERENCE_DEVICE=auto
OUROBOROS_INFERENCE_DTYPE=auto

# Training canary controls.
OUROBOROS_TRAIN_DATA_DIR=data/coconut_v1
OUROBOROS_TRAIN_OUTPUT_DIR=runs/stage3_canary
OUROBOROS_TRAIN_MAX_STAGE=1
OUROBOROS_TRAIN_MAX_SAMPLES=128
OUROBOROS_TRAIN_MAX_STEPS=10
OUROBOROS_TRAIN_BATCH_SIZE=2
OUROBOROS_TRAIN_GRAD_ACCUM=8
OUROBOROS_TRAIN_USE_4BIT=1
OUROBOROS_TRAIN_PUSH_TO_HUB=0

# DGAC Hub-anchor continuation.
OUROBOROS_RESUME_ANCHOR_REPO=WeirdRunner/Ouroboros
OUROBOROS_RESUME_ANCHOR_SUBDIR=diloco_state/anchor

# lm-evaluation-harness smoke controls.
OUROBOROS_LM_EVAL_TASKS=arc_easy
OUROBOROS_LM_EVAL_LIMIT=10
OUROBOROS_LM_EVAL_OUTPUT_DIR=runs/lm_eval_smoke
OUROBOROS_LM_EVAL_BASE_MODEL=ai21labs/AI21-Jamba-Reasoning-3B
OUROBOROS_LM_EVAL_ADAPTER=WeirdRunner/Ouroboros
OUROBOROS_LM_EVAL_ADAPTER_SUBFOLDER=diloco_state/anchor
OUROBOROS_LM_EVAL_ADAPTER_CACHE_DIR=runs/lm_eval_adapter
OUROBOROS_LM_EVAL_BATCH_SIZE=1
OUROBOROS_LM_EVAL_DEVICE=cuda:0
OUROBOROS_LM_EVAL_DTYPE=float16
OUROBOROS_LM_EVAL_4BIT=0

# Artifact-only experiment-readiness gate.
OUROBOROS_EVAL_GATE_COMPARISON_DIR=runs/coconut_val_compare
OUROBOROS_EVAL_GATE_LM_EVAL_DIR=runs/lm_eval_smoke
OUROBOROS_EVAL_GATE_OUTPUT_PATH=runs/experiment_readiness.json
OUROBOROS_EVAL_GATE_REQUIRE_LM_EVAL=0
OUROBOROS_EVAL_GATE_ALLOW_NOT_READY=1

# Local Mac fallback.
PYTORCH_ENABLE_MPS_FALLBACK=1
